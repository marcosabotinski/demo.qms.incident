# Copy to .env, fill in, chmod 600. Scripts load .env; already-exported vars win.
# AWS credentials come from ~/.aws (or AWS_* env), not from this file.
# allow-my-ip.sh needs CLOUDFLARE_API_TOKEN and CF_ZONE_ID only.
# Minimum token permission: Account Firewall Access Rules Edit (write) on the
# account that owns the zone. It does not need DNS or zone-settings edit.

CLOUDFLARE_API_TOKEN=
CF_ZONE_ID=
DEMO_HOSTNAME=
